{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "Data Source=../Data/app.db"
  },
  "Jwt": {
    "Secret": "dev-secret-key-at-least-32-chars-long-for-jwt-signing",
    "Issuer": "lighthouse",
    "Audience": "lighthouse-client",
    "ExpirationMinutes": 60,
    "RefreshExpirationDays": 1,
    "RefreshExpirationDaysExtended": 30
  },
  "Docker": {
    //"Host": "unix:///var/run/docker.sock",
    "Host": "npipe://./pipe/docker_engine"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:5174", "http://localhost:5175", "http://localhost:5176", "http://localhost:3030" ]
  },
  "Security": {
    "PasswordHashing": {
      "WorkFactor": 12
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Lighthouse.Services.DockerEventsMonitorService": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "ComposeDiscovery": {
    "RootPath": "/app/compose-files",
    "CacheDurationSeconds": 300,
    // Per-developer host path. Do NOT hardcode here; set it in the gitignored
    // appsettings.Development.local.json (generated by dev-setup/setup scripts).
    "HostPathMapping": ""
  },
  "Email": {
    "Provider": "Mock",
    "FromEmail": "noreply@lighthouse.lakio.io",
    "FromName": "Lighthouse",
    "AppBaseUrl": "http://localhost:5173",
    "MockLogPath": "/app/logs/emails",
    "Resend": {
      "ApiKey": null
    }
  }
}
